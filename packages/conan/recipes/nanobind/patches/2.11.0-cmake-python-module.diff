diff --git a/cmake/nanobind-config.cmake b/cmake/nanobind-config.cmake
index d99dd79ac..bfda2778a 100644
--- a/cmake/nanobind-config.cmake
+++ b/cmake/nanobind-config.cmake
@@ -1,7 +1,21 @@
 include_guard(GLOBAL)

 if (NOT TARGET Python::Module)
-  message(FATAL_ERROR "You must invoke 'find_package(Python COMPONENTS Interpreter Development REQUIRED)' prior to including nanobind.")
+  if (TARGET Python3::Module)
+    # Conan's cpython package intercepts find_package(Python) via a generated
+    # FindPython.cmake wrapper that routes through FindPython3, creating
+    # Python3::* targets but not Python::*.  Alias Python::Module so that
+    # nanobind's cmake functions (nanobind_add_module etc.) can link against it.
+    add_library(Python::Module ALIAS Python3::Module)
+    if(NOT Python_EXECUTABLE AND Python3_EXECUTABLE)
+      set(Python_EXECUTABLE "${Python3_EXECUTABLE}")
+    endif()
+    if(NOT Python_VERSION AND Python3_VERSION)
+      set(Python_VERSION "${Python3_VERSION}")
+    endif()
+  else()
+    message(FATAL_ERROR "You must invoke 'find_package(Python COMPONENTS Interpreter Development REQUIRED)' prior to including nanobind.")
+  endif()
 endif()

 if (Python_VERSION VERSION_LESS "3.9")
