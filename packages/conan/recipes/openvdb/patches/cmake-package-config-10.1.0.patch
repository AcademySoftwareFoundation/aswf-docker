--- a/openvdb/openvdb/CMakeLists.txt
+++ b/openvdb/openvdb/CMakeLists.txt
@@ -657,8 +657,16 @@
 # Configure static build
 
 if(OPENVDB_CORE_STATIC)
+  # ASWF: use BUILD_INTERFACE/INSTALL_INTERFACE generator expressions so
+  # these PUBLIC include dirs can be exported via install(EXPORT ...);
+  # otherwise CMake refuses to export a target whose interface include
+  # dirs point into the source or build tree.
   target_include_directories(openvdb_static
-    PUBLIC ../ ${CMAKE_CURRENT_BINARY_DIR} ${CMAKE_CURRENT_BINARY_DIR}/openvdb
+    PUBLIC
+      $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/..>
+      $<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}>
+      $<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}/openvdb>
+      $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
     PRIVATE .
   )
 
@@ -690,8 +698,13 @@
 # Configure shared build
 
 if(OPENVDB_CORE_SHARED)
+  # ASWF: see the matching comment on the openvdb_static target above.
   target_include_directories(openvdb_shared
-    PUBLIC ../ ${CMAKE_CURRENT_BINARY_DIR} ${CMAKE_CURRENT_BINARY_DIR}/openvdb
+    PUBLIC
+      $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/..>
+      $<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}>
+      $<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}/openvdb>
+      $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
     PRIVATE .
   )
 
@@ -728,6 +741,7 @@
 
 if(OPENVDB_CORE_STATIC)
   install(TARGETS openvdb_static
+    EXPORT OpenVDBTargets
     RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
     LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
     ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
@@ -736,12 +750,39 @@
 
 if(OPENVDB_CORE_SHARED)
   install(TARGETS openvdb_shared
+    EXPORT OpenVDBTargets
     RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
     LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
     ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
   )
 endif()
 
+# ASWF: upstream only ships the module-mode cmake/FindOpenVDB.cmake, which
+# is not installed by this build (see OPENVDB_INSTALL_CMAKE_MODULES); export
+# a target-based CMake package config instead so non-Conan CMake consumers
+# of this installation can find_package(OpenVDB CONFIG).
+install(EXPORT OpenVDBTargets
+  FILE OpenVDBTargets.cmake
+  NAMESPACE OpenVDB::
+  DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/OpenVDB
+)
+include(CMakePackageConfigHelpers)
+write_basic_package_version_file(
+  ${CMAKE_CURRENT_BINARY_DIR}/OpenVDBConfigVersion.cmake
+  VERSION ${OpenVDB_VERSION}
+  COMPATIBILITY AnyNewerVersion
+)
+configure_package_config_file(
+  ${CMAKE_CURRENT_SOURCE_DIR}/OpenVDBConfig.cmake.in
+  ${CMAKE_CURRENT_BINARY_DIR}/OpenVDBConfig.cmake
+  INSTALL_DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/OpenVDB
+)
+install(FILES
+  ${CMAKE_CURRENT_BINARY_DIR}/OpenVDBConfig.cmake
+  ${CMAKE_CURRENT_BINARY_DIR}/OpenVDBConfigVersion.cmake
+  DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/OpenVDB
+)
+
 install(FILES ${OPENVDB_LIBRARY_INCLUDE_FILES} DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/openvdb)
 install(FILES ${CMAKE_CURRENT_BINARY_DIR}/openvdb/version.h DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/openvdb)
 install(FILES ${OPENVDB_LIBRARY_IO_INCLUDE_FILES} DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/openvdb/io)
