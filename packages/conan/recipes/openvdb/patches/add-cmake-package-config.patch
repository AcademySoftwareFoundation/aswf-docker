diff --git a/openvdb/openvdb/OpenVDBConfig.cmake.in b/openvdb/openvdb/OpenVDBConfig.cmake.in
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/openvdb/openvdb/OpenVDBConfig.cmake.in
@@ -0,0 +1,46 @@
+# Copyright Contributors to the OpenVDB Project
+# SPDX-License-Identifier: Apache-2.0
+#
+# ASWF: this file does not exist upstream. OpenVDB only ships the
+# module-mode cmake/FindOpenVDB.cmake for locating an existing OpenVDB
+# installation, not a target-based config for the one built by this
+# project. It is added so that a non-Conan CMake consumer of this
+# installation can use find_package(OpenVDB CONFIG), the same way Conan
+# consumers already do via the CMakeDeps generator.
+
+@PACKAGE_INIT@
+
+include(CMakeFindDependencyMacro)
+
+find_dependency(TBB REQUIRED)
+# ASWF: pass CONFIG explicitly; CMake 4.x removed the bundled FindBoost
+# module, so this always resolves via Boost's own BoostConfig.cmake anyway,
+# but without CONFIG, CMake still raises a CMP0167 dev warning about the
+# now-moot Module-vs-Config ambiguity.
+find_dependency(Boost REQUIRED COMPONENTS iostreams CONFIG)
+if(@USE_IMATH_HALF@)
+  find_dependency(Imath REQUIRED CONFIG)
+endif()
+if(@USE_BLOSC@ OR @USE_ZLIB@)
+  find_dependency(ZLIB REQUIRED)
+endif()
+if(@USE_BLOSC@)
+  find_dependency(Blosc REQUIRED)
+endif()
+if(@USE_LOG4CPLUS@)
+  # ASWF: log4cplus's own upstream config names its package/target
+  # "log4cplus" (lowercase), but OpenVDB's build links against
+  # "Log4cplus::log4cplus" (see cmake/FindLog4cplus.cmake and the
+  # cmake_target_name override in the log4cplus Conan recipe usage),
+  # and that mixed-case name is what ends up baked into
+  # OpenVDBTargets.cmake. Find the real (lowercase) package and alias
+  # it to the name OpenVDBTargets.cmake actually references.
+  find_dependency(log4cplus REQUIRED)
+  if(TARGET log4cplus::log4cplus AND NOT TARGET Log4cplus::log4cplus)
+    add_library(Log4cplus::log4cplus ALIAS log4cplus::log4cplus)
+  endif()
+endif()
+
+include("${CMAKE_CURRENT_LIST_DIR}/OpenVDBTargets.cmake")
+
+check_required_components(OpenVDB)
