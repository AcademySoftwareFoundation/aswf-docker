ARG ASWF_ORG
ARG ASWF_PKG_ORG
ARG CI_COMMON_VERSION
ARG ASWF_CLANG_MAJOR_VERSION
ARG ASWF_CONAN_CHANNEL
ARG ASWF_CXX_STANDARD

ARG ASWF_VFXPLATFORM_VERSION


ARG ASWF_QT_VERSION
ARG ASWF_LIBJXL_VERSION
ARG ASWF_LIBULTRAHDR_VERSION
ARG ASWF_OPENJPH_VERSION
ARG ASWF_OPENIMAGEIO_VERSION
ARG ASWF_NUMPY_VERSION
ARG ASWF_VFXPLATFORM_VERSION




FROM ${ASWF_ORG}/ci-common:${CI_COMMON_VERSION}-clang${ASWF_CLANG_MAJOR_VERSION} AS ci-oiio


ARG ASWF_ORG
ARG ASWF_CONAN_HOME
ARG ASWF_PKG_ORG
ARG ASWF_VERSION
ARG CI_COMMON_VERSION
ARG ASWF_CONAN_CHANNEL
ARG ASWF_CXX_STANDARD



ARG ASWF_QT_VERSION
ARG ASWF_LIBJXL_VERSION
ARG ASWF_LIBULTRAHDR_VERSION
ARG ASWF_OPENJPH_VERSION
ARG ASWF_OPENIMAGEIO_VERSION
ARG ASWF_NUMPY_VERSION
ARG ASWF_VFXPLATFORM_VERSION


LABEL org.opencontainers.image.name="$ASWF_ORG/ci-oiio"
LABEL org.opencontainers.image.title="OpenImageIO CI Docker Image"
LABEL org.opencontainers.image.description="Contains: Python, OpenEXR, Partio and other OpenImageIO upstream dependencies\
Warning: this image does *not* contain OpenImageIO itself as it is used to *build* OpenImageIO!"
LABEL org.opencontainers.image.url="http://aswf.io/"
LABEL org.opencontainers.image.source="https://github.com/AcademySoftwareFoundation/aswf-docker/blob/main/ci-oiio/Dockerfile"
LABEL org.opencontainers.image.vendor="AcademySoftwareFoundation"
LABEL org.opencontainers.image.authors="Built by aswf.io CI Working Group"
LABEL org.opencontainers.image.version="${ASWF_VERSION}"


LABEL com.vfxplatform.version="${ASWF_VFXPLATFORM_VERSION}"


LABEL io.aswf.docker.versions.qt="$ASWF_QT_VERSION"
LABEL io.aswf.docker.versions.libjxl="$ASWF_LIBJXL_VERSION"
LABEL io.aswf.docker.versions.libultrahdr="$ASWF_LIBULTRAHDR_VERSION"
LABEL io.aswf.docker.versions.openjph="$ASWF_OPENJPH_VERSION"
LABEL io.aswf.docker.versions.openimageio="$ASWF_OPENIMAGEIO_VERSION"
LABEL io.aswf.docker.versions.numpy="$ASWF_NUMPY_VERSION"
LABEL io.aswf.docker.versions.vfxplatform="$ASWF_VFXPLATFORM_VERSION"


ENV ASWF_ORG=${ASWF_ORG}
ENV ASWF_VERSION=${ASWF_VERSION}
ENV ASWF_INSTALL_PREFIX=/usr/local
ENV ASWF_CXX_STANDARD=${ASWF_CXX_STANDARD}



ENV ASWF_VFXPLATFORM_VERSION=${ASWF_VFXPLATFORM_VERSION}


ENV ASWF_QT_VERSION=$ASWF_QT_VERSION
ENV ASWF_LIBJXL_VERSION=$ASWF_LIBJXL_VERSION
ENV ASWF_LIBULTRAHDR_VERSION=$ASWF_LIBULTRAHDR_VERSION
ENV ASWF_OPENJPH_VERSION=$ASWF_OPENJPH_VERSION
ENV ASWF_OPENIMAGEIO_VERSION=$ASWF_OPENIMAGEIO_VERSION
ENV ASWF_NUMPY_VERSION=$ASWF_NUMPY_VERSION
ENV ASWF_VFXPLATFORM_VERSION=$ASWF_VFXPLATFORM_VERSION


COPY ci-oiio/README.md ci-oiio/image.yaml /usr/local/aswf/

COPY scripts/vfx/build_oiio.sh /usr/local/aswf


ARG ASWF_PYTHON_MAJOR_MINOR_VERSION
ENV ASWF_PYTHON_MAJOR_MINOR_VERSION=${ASWF_PYTHON_MAJOR_MINOR_VERSION}

# conan-only packages
COPY <<EOF /usr/local/conanfile.txt
[generators]
[imports]
., * -> .
[requires]
qt/${ASWF_QT_VERSION}@${ASWF_PKG_ORG}/${ASWF_CONAN_CHANNEL}
libjxl/${ASWF_LIBJXL_VERSION}@${ASWF_PKG_ORG}/${ASWF_CONAN_CHANNEL}
libultrahdr/${ASWF_LIBULTRAHDR_VERSION}@${ASWF_PKG_ORG}/${ASWF_CONAN_CHANNEL}
openjph/${ASWF_OPENJPH_VERSION}@${ASWF_PKG_ORG}/${ASWF_CONAN_CHANNEL}
openimageio/${ASWF_OPENIMAGEIO_VERSION}@${ASWF_PKG_ORG}/${ASWF_CONAN_CHANNEL}
EOF

ENV CONAN_HOME=${ASWF_CONAN_HOME}/.conan2

RUN --mount=type=cache,id=aswf-conan-cache,sharing=locked,target=/opt/conan_home/d \
    --mount=type=bind,rw,target=/opt/conan_home/.conan2,source=packages/conan/settings \
    conan install /usr/local \
        --profile:all "${ASWF_CONAN_CHANNEL}" \
        --deployer aswf_deploy \
        --deployer-folder /usr/local \
        --conf user.aswf:exclude_package="openimageio" \
    && rm -rf /tmp/downloads/*

